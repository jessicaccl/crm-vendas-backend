# Copie para .env e preencha. O .env não vai para o Git.
DB_URL=jdbc:postgresql://localhost:5432/crm_db
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Origens do frontend liberadas no CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cria clientes de exemplo quando o banco está vazio
DEMO_DATA=true
