# Copie para .env e preencha. O .env não vai para o Git.
DB_URL=jdbc:postgresql://localhost:5432/crm_db
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Chave que assina os tokens de login: 32+ caracteres aleatórios
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres

# Sua conta de administradora (opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuário público de demonstração (aparece na tela de login)
DEMO_USER_ENABLED=true
DEMO_USER_EMAIL=demo@crmpro.dev
DEMO_USER_PASSWORD=demo1234

# Origens do frontend liberadas no CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cria clientes e negócios de exemplo quando o banco está vazio
DEMO_DATA=true
# Restaura os exemplos periodicamente ("-" desliga). Na demo online: 0 0 4 * * *
DEMO_RESET_CRON=-
